<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ethercat_hardware</name>
  <version>2.0.0</version>
  <description>Package for creating a hardware interface to the robot using the EtherCAT motor controller/driver</description>
  <maintainer email="ros-orphaned-packages@googlegroups.com">ROS Orphaned Package Maintainers</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/ethercat_hardware</url>

  <author email="wheeler@willowgarage.com">Rob Wheeler</author>
  <author email="dking@willowgarage.com">Derek King</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>pr2_msgs</depend>
  <depend>pr2_hardware_interface</depend>
  <depend>eml</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>pluginlib</depend>
  <depend>boost</depend>
  <depend>tinyxml</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

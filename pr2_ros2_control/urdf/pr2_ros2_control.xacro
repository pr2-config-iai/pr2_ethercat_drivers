<?xml version="1.0"?>
<!--
  <ros2_control> block for the PR2's EtherCAT motor chain.

  Every joint driven by a PR2 transmission is listed (45 on the IAI PR2: the same set ROS 1
  published on /joint_states, including the gripper's passive finger joints and the screw/slider
  joints). The transmissions themselves stay in the robot description in their ROS 1 form; the
  hardware component reads them from /robot_description.

  Every joint has position/velocity/effort state interfaces; the actuated ones (all but the passive
  joints below, which have no <safety_controller> in the URDF) also an effort command interface.
  Commands are only used with commanding_enabled, for the joints in commanded_joints (decision D20).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="pr2_ros2_control_joints" value="${[
    'bl_caster_l_wheel_joint', 'bl_caster_r_wheel_joint', 'bl_caster_rotation_joint',
    'br_caster_l_wheel_joint', 'br_caster_r_wheel_joint', 'br_caster_rotation_joint',
    'fl_caster_l_wheel_joint', 'fl_caster_r_wheel_joint', 'fl_caster_rotation_joint',
    'fr_caster_l_wheel_joint', 'fr_caster_r_wheel_joint', 'fr_caster_rotation_joint',
    'torso_lift_joint', 'torso_lift_motor_screw_joint',
    'head_pan_joint', 'head_tilt_joint', 'laser_tilt_mount_joint',
    'l_shoulder_pan_joint', 'l_shoulder_lift_joint', 'l_upper_arm_roll_joint', 'l_elbow_flex_joint',
    'l_forearm_roll_joint', 'l_wrist_flex_joint', 'l_wrist_roll_joint',
    'l_gripper_joint', 'l_gripper_motor_screw_joint', 'l_gripper_motor_slider_joint',
    'l_gripper_l_finger_joint', 'l_gripper_r_finger_joint', 'l_gripper_l_finger_tip_joint', 'l_gripper_r_finger_tip_joint',
    'r_shoulder_pan_joint', 'r_shoulder_lift_joint', 'r_upper_arm_roll_joint', 'r_elbow_flex_joint',
    'r_forearm_roll_joint', 'r_wrist_flex_joint', 'r_wrist_roll_joint',
    'r_gripper_joint', 'r_gripper_motor_screw_joint', 'r_gripper_motor_slider_joint',
    'r_gripper_l_finger_joint', 'r_gripper_r_finger_joint', 'r_gripper_l_finger_tip_joint', 'r_gripper_r_finger_tip_joint']}"/>

  <xacro:property name="pr2_ros2_control_passive_joints" value="${[
    'torso_lift_motor_screw_joint',
    'l_gripper_motor_screw_joint', 'l_gripper_motor_slider_joint',
    'l_gripper_l_finger_joint', 'l_gripper_r_finger_joint', 'l_gripper_l_finger_tip_joint', 'l_gripper_r_finger_tip_joint',
    'r_gripper_motor_screw_joint', 'r_gripper_motor_slider_joint',
    'r_gripper_l_finger_joint', 'r_gripper_r_finger_joint', 'r_gripper_l_finger_tip_joint', 'r_gripper_r_finger_tip_joint']}"/>

  <xacro:macro name="pr2_ros2_control_state_joints" params="joints">
    <xacro:if value="${joints}">
      <joint name="${joints[0]}">
        <xacro:unless value="${joints[0] in pr2_ros2_control_passive_joints}">
          <command_interface name="effort"/>
        </xacro:unless>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <xacro:pr2_ros2_control_state_joints joints="${joints[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="pr2_ros2_control"
               params="interface:=ecat0 allow_unprogrammed:=false commanding_enabled:=false commanded_joints:='' max_effort_fraction:=0.1 min_acceptable_rt_loop_frequency:=750.0">
    <ros2_control name="pr2_ethercat" type="system">
      <hardware>
        <plugin>pr2_ros2_control/Pr2EthercatSystem</plugin>
        <param name="interface">${interface}</param>
        <param name="allow_unprogrammed">${allow_unprogrammed}</param>
        <param name="robot_description_topic">/robot_description</param>
        <param name="commanding_enabled">${commanding_enabled}</param>
        <param name="commanded_joints">${commanded_joints}</param>
        <param name="max_effort_fraction">${max_effort_fraction}</param>
        <param name="min_acceptable_rt_loop_frequency">${min_acceptable_rt_loop_frequency}</param>
      </hardware>
      <xacro:pr2_ros2_control_state_joints joints="${pr2_ros2_control_joints}"/>
    </ros2_control>
  </xacro:macro>

</robot>
